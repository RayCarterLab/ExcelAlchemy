{
  "schema_version": 1,
  "purpose": "Structured module index for classifying ExcelAlchemy source paths by API boundary.",
  "source_documents": [
    "docs/public-api.md",
    "docs/agent/architecture-boundaries.md",
    "docs/repo-map.md",
    "docs/domain-model.md"
  ],
  "public_api_modules": [
    {
      "module": "excelalchemy",
      "path": "src/excelalchemy/__init__.py",
      "role": "Package root and common public facade."
    },
    {
      "module": "excelalchemy.config",
      "path": "src/excelalchemy/config.py",
      "role": "ImporterConfig, ExporterConfig, and ImportMode."
    },
    {
      "module": "excelalchemy.columns",
      "path": "src/excelalchemy/columns.py",
      "role": "ExcelColumn declarations and immutable column specs."
    },
    {
      "module": "excelalchemy.metadata",
      "path": "src/excelalchemy/metadata.py",
      "role": "Resolved runtime field metadata."
    },
    {
      "module": "excelalchemy.results",
      "path": "src/excelalchemy/results.py",
      "role": "ImportResult, preflight results, lifecycle events, issue maps, and API helpers."
    },
    {
      "module": "excelalchemy.errors",
      "path": "src/excelalchemy/errors.py",
      "role": "Public exception re-export module."
    },
    {
      "module": "excelalchemy.exceptions",
      "path": "src/excelalchemy/exceptions.py",
      "role": "Stable public exception module."
    },
    {
      "module": "excelalchemy.storage",
      "path": "src/excelalchemy/storage.py",
      "role": "ExcelStorage protocol."
    },
    {
      "module": "excelalchemy.codecs",
      "path": "src/excelalchemy/codecs/",
      "role": "Public built-in field codecs and codec extension base classes."
    },
    {
      "module": "excelalchemy.artifacts",
      "path": "src/excelalchemy/artifacts.py",
      "role": "ExcelArtifact transport wrapper."
    }
  ],
  "implementation_modules": [
    {
      "module": "excelalchemy.runtime.facade",
      "path": "src/excelalchemy/runtime/facade.py",
      "role": "Facade implementation and main workflow orchestration."
    },
    {
      "module": "excelalchemy.runtime.import_session",
      "path": "src/excelalchemy/runtime/import_session.py",
      "role": "One import run lifecycle, state, and event emission."
    },
    {
      "module": "excelalchemy.runtime.preflight",
      "path": "src/excelalchemy/runtime/preflight.py",
      "role": "Read-only structural preflight workflow."
    },
    {
      "module": "excelalchemy.schema.layout",
      "path": "src/excelalchemy/schema/layout.py",
      "role": "Excel-facing schema layout extraction and flattening."
    },
    {
      "module": "excelalchemy.workbook.headers",
      "path": "src/excelalchemy/workbook/headers.py",
      "role": "Workbook header parsing and validation."
    },
    {
      "module": "excelalchemy.workbook.header_models",
      "path": "src/excelalchemy/workbook/header_models.py",
      "role": "Header validation result models and merged-header records."
    },
    {
      "module": "excelalchemy.workbook.table",
      "path": "src/excelalchemy/workbook/table.py",
      "role": "WorksheetTable runtime table abstraction."
    },
    {
      "module": "excelalchemy.runtime.rows",
      "path": "src/excelalchemy/runtime/rows.py",
      "role": "Worksheet row aggregation and issue tracking."
    },
    {
      "module": "excelalchemy.runtime.executor",
      "path": "src/excelalchemy/runtime/executor.py",
      "role": "Row validation and callback dispatch."
    },
    {
      "module": "excelalchemy.rendering.renderer",
      "path": "src/excelalchemy/rendering/renderer.py",
      "role": "Workbook rendering coordination."
    },
    {
      "module": "excelalchemy.rendering.writer",
      "path": "src/excelalchemy/rendering/writer.py",
      "role": "Low-level workbook writing and styling."
    },
    {
      "module": "excelalchemy.adapters.pydantic",
      "path": "src/excelalchemy/adapters/pydantic.py",
      "role": "Pydantic integration boundary."
    },
    {
      "module": "excelalchemy.messages",
      "path": "src/excelalchemy/messages.py",
      "role": "Runtime and workbook display message handling."
    },
    {
      "module": "excelalchemy.storage_gateway",
      "path": "src/excelalchemy/storage_gateway.py",
      "role": "Configured storage resolution and missing-storage fallback."
    },
    {
      "module": "excelalchemy.storage_minio",
      "path": "src/excelalchemy/storage_minio.py",
      "role": "Built-in Minio-compatible storage backend."
    },
    {
      "module": "excelalchemy.primitives.*",
      "path": "src/excelalchemy/primitives/",
      "role": "Internal constants, identity wrappers, and row payload aliases."
    }
  ],
  "removed_compatibility_modules": [
    "excelalchemy.const",
    "excelalchemy.exc",
    "excelalchemy.identity",
    "excelalchemy.header_models",
    "excelalchemy.types.*",
    "excelalchemy.util.convertor",
    "excelalchemy.core.*",
    "excelalchemy.helper.*",
    "excelalchemy.i18n.*",
    "excelalchemy._primitives.*"
  ],
  "harness_modules": [
    {
      "module": "harness.loop",
      "path": "harness/loop.py",
      "role": "Deterministic workflow loop, retry policy, and agent output validation."
    },
    {
      "module": "harness.state",
      "path": "harness/state.py",
      "role": "RunState, StepRecord, JSON serialization, retry state, and fix context."
    },
    {
      "module": "harness.evaluators.local",
      "path": "harness/evaluators/local.py",
      "role": "Local validation checks for tests, diff size, and unrelated file changes."
    },
    {
      "module": "harness.runner",
      "path": "harness/runner.py",
      "role": "Convenience entry point for running harness tasks."
    }
  ],
  "preferred_new_code_imports": [
    "excelalchemy",
    "excelalchemy.config",
    "excelalchemy.columns",
    "excelalchemy.metadata",
    "excelalchemy.results",
    "excelalchemy.errors",
    "excelalchemy.exceptions",
    "excelalchemy.storage",
    "excelalchemy.codecs"
  ],
  "avoid_in_application_code": [
    "excelalchemy.runtime.*",
    "excelalchemy.schema.*",
    "excelalchemy.workbook.*",
    "excelalchemy.rendering.*",
    "excelalchemy.adapters.*",
    "excelalchemy.primitives.*"
  ]
}
